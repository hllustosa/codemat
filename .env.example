# Copy to repo-root `.env` (gitignored) for Makefile / Admin SDK.
# Frontend Firebase web config lives in apps/web/.env.local (see below).

# Backend seed / Admin (local only — never commit the JSON file)
GOOGLE_APPLICATION_CREDENTIALS=./backend/credentials/service-account.json

# Functions: use local JSON (default) or Firestore after `make seed`
# CONTENT_SOURCE=firestore

# --- apps/web/.env.local (copy these into that file for Next.js) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=codematbr.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=codematbr
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=codematbr.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/codematbr/us-central1/api
# NEXT_PUBLIC_SITE_URL=https://codemat--codematbr.us-central1.hosted.app
