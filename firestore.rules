rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public curriculum
    match /catalog/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /exercises/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /lessons/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Hidden test cases — Admin SDK only
    match /exerciseSecrets/{id} {
      allow read, write: if false;
    }

    // Per-user progress — owners only; prefer Cloud Functions for writes
    match /UserStats/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
